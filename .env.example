# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Vision (Inspection agent) and the Day 1 vision check
INSPECTBOT_VISION_MODEL=claude-sonnet-5-5
# Verification agent (the judge) - defaults to the vision model
INSPECTBOT_VERIFY_MODEL=claude-sonnet-5-5
# Planning agent and ToT scoring
INSPECTBOT_TEXT_MODEL=claude-haiku-5-5
# Where runs (images, task records) are written
INSPECTBOT_RUNS_DIR=runs
# Retrieval embeddings: hashing (offline, default) or minilm (Chroma local model, downloads once)
INSPECTBOT_EMBEDDINGS=hashing
